# Copy this file to .env and edit the values:
#
#     cp .env.example .env
#
# .env is git-ignored, so your personal paths never get committed.

# The folder holding your videos and music. This is the only setting you must
# change. Sub-folders are scanned automatically.
#
# The app reads from this folder, and writes to it in exactly one case: a
# subtitle you download is saved next to the video it belongs to, as a .srt or
# .vtt named after that video - for example OS_Ford-V-Ferrari_1080p_en1.srt.
# Nothing else is ever created, and nothing is ever modified or deleted. Nothing
# is written until you press a download button in the player.
#
#   Linux / macOS:  /home/you/Videos      or  /Users/you/Movies
#   External drive: /media/you/MyDrive    or  /Volumes/MyDrive
MEDIA_DIR=/home/you/Videos

# Port the app listens on. Change it if something else already uses 5000
# (on macOS, AirPlay Receiver does).
PORT=5000

# Port for the Vite dev server, used only by ./scripts/run-dev.
WEB_DEV_PORT=5173

# How ./1_run starts the app: "docker" or "node". ./0_setup sets this for you based
# on what your machine has. Change it here to switch, or override per-run with
# ./1_run --docker / ./1_run --node
RUN_MODE=node


# ---------------------------------------------------------------------------
# Subtitles (optional)
#
# All of this can stay empty. With no keys set, the subtitle menus still list
# whatever .srt / .vtt files are already sitting next to your videos, exactly as
# before - only the "search online" part is switched off.
# ---------------------------------------------------------------------------

# Free API key from https://www.opensubtitles.com -> account -> API consumers.
# This is the source worth having: it is the only one that can match on a hash of
# the video file itself, which means the subtitle it finds was timed against your
# exact copy and will be in sync. Free accounts get a small number of downloads
# per day, so the app shows you how many are left.
#
# More than one person in the house? Put every key here, separated by commas, and
# the daily allowances add up - the app moves to the next key when one runs out:
#   OPENSUBTITLES_API_KEY=alicekey,bobkey,carolkey
# Searching is free and never runs out; only downloading is counted.
OPENSUBTITLES_API_KEY=

# Free API key from https://subdl.com -> account panel. A second source, used as
# a fallback: it cannot match on file hash, but it has its own daily allowance,
# so it helps on a day the first one runs out. Also accepts a comma-separated
# list.
SUBDL_API_KEY=

# Subscene. No account and no key, so this one works as it stands - you find a
# subtitle on the site yourself, paste its ID into the player, and the app
# downloads and unzips it for you.
#
# The ID is the number at the end of a subtitle's page URL: for
# https://sub-scene.com/subtitle/3358444 the ID is 3358444.
#
# This line is the whole of its configuration. Subscene is a source of its own
# and takes no part in SUBTITLE_PROVIDERS at the bottom of this file - the app
# cannot search it (its search page is behind a bot check, and getting past that
# is not something this project does), so it never competes with the two sources
# above and there is no ordering for it to be part of.
#
#   set   -> the ID box works, and asks this address
#   empty -> the ID box is switched off, and says so
#
# The address is a setting because the original subscene.com closed in May 2024
# and the site answering today is a clone that may move again. If the box tells
# you this address is not answering, find one that works and put it here.
SUBSCENE_URL=https://sub-scene.com

# Which languages the subtitle menus offer, in order. Two-letter codes.
# Leave empty for: en,fr,es,hi,ja,it,ko,de,pt,ar
# (Note Hindi is "hi", not "hn".)
SUBTITLE_LANGUAGES=

# Which sources to *search*, and the order you prefer them in.
# Leave empty for: opensubtitles,subdl
#
# The order is a preference, not an override: results are ranked by how well they
# match your file first, and your ordering only decides between equally good
# matches. A subtitle matched by file hash always wins, whoever supplied it,
# because one that is two seconds out of sync is worse than none at all.
#
# Subscene is not one of these and does not belong on this line. It has no search
# to take part in - it is switched on by SUBSCENE_URL above and nothing else.
SUBTITLE_PROVIDERS=
